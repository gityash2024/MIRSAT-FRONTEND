# Frontend Production Environment Variables
# Copy this file to .env.production for production builds

# Production API URL - Update this to your production backend URL
VITE_API_URL=https://mirsat.mymultimeds.com/api/v1

# Frontend URL (Production: https://mirsat.co  |  Staging: https://mirsat-frontend.vercel.app)
VITE_FRONTEND_URL=https://mirsat.co

# Cloudflare Turnstile site key. Leave EMPTY to disable the widget entirely -
# the login and forgot-password pages then render and behave exactly as they
# did before it existed. Must be set in lockstep with TURNSTILE_ENABLED on the
# backend.
# Cloudflare test keys (work on any hostname, including localhost):
#   1x00000000000000000000AA  always passes
#   2x00000000000000000000AB  always blocks
#   3x00000000000000000000FF  forces the interactive challenge
VITE_TURNSTILE_SITE_KEY=
